# ─────────────────────────────────────────────
# Copy this file to .env and fill values locally.
# .env is git-ignored; .env.example is committed.
# ─────────────────────────────────────────────

# PostgreSQL — one DB per service
POSTGRES_USER=agency
POSTGRES_PASSWORD=change_me_in_local_env

# Announcements DB
ANNOUNCEMENTS_DB=announcements
ANNOUNCEMENTS_DB_PORT=5432

# Offers DB
OFFERS_DB=offers
OFFERS_DB_PORT=5433

# Favourites DB
FAVOURITES_DB=favourites
FAVOURITES_DB_PORT=5434

# Visits DB
VISITS_DB=visits
VISITS_DB_PORT=5435

# Service ports (host side)
ANNOUNCEMENTS_SERVICE_PORT=8081
OFFERS_SERVICE_PORT=8082
FAVOURITES_SERVICE_PORT=8083
VISITS_SERVICE_PORT=8084
FRONTEND_PORT=3000

# Inter-service URLs (inside the Docker network)
ANNOUNCEMENTS_SERVICE_URL=http://announcements-service:8080
OFFERS_SERVICE_URL=http://offers-service:8080
FAVOURITES_SERVICE_URL=http://favourites-service:8000
VISITS_SERVICE_URL=http://visits-service:8000